[Unit]
Description=Update Clash Web from its stable GitHub release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/clash-web-service --apply-update
StateDirectory=clash-web-update
StateDirectoryMode=0755
CacheDirectory=clash-web-update
CacheDirectoryMode=0700
UMask=0022
PrivateTmp=true
TimeoutStartSec=20min
